<Project Sdk="Microsoft.NET.Sdk">
  <!-- Bridge logic compiled twice: net472 is what KSP's Mono runs, net10.0 is the host test runtime. Linked sources stay C# 7.3. -->
  <PropertyGroup><TargetFrameworks>net10.0;net472</TargetFrameworks><LangVersion>7.3</LangVersion><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.3.2" />
    <PackageReference Include="MSTest.TestAdapter" Version="2.2.10" />
    <PackageReference Include="MSTest.TestFramework" Version="2.2.10" />
    <ProjectReference Include="../Contracts/KspControl.Contracts.csproj" />
    <Compile Include="../Bridge/ObservationQueue.cs" Link="ObservationQueue.cs" />
    <Compile Include="../Bridge/LoopbackServer.cs" Link="LoopbackServer.cs" />
    <Compile Include="../Bridge/ExecutionAuthority.cs" Link="ExecutionAuthority.cs" />
    <Compile Include="../Bridge/ControlDispatcher.cs" Link="ControlDispatcher.cs" />
    <Compile Include="../Bridge/GrantWatcher.cs" Link="GrantWatcher.cs" />
    <Compile Include="../Bridge/SuspensionStore.cs" Link="SuspensionStore.cs" />
    <Compile Include="../Bridge/PartFilters.cs" Link="PartFilters.cs" />
    <Compile Include="../Contracts/Fixtures/GrantFixture.cs" Link="Fixtures/GrantFixture.cs" />
    <None Include="../Contracts/Fixtures/grant-fixture.json" Link="Fixtures/grant-fixture.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Contracts/Fixtures/grant-fixture.key" Link="Fixtures/grant-fixture.key" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
